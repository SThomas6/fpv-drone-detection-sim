# Third-party source trees (installed by scripts/install.sh, not vendored)
third_party/
# A symlink to ~/Projects/PX4-Autopilot, so no trailing slash (that would only
# match a real directory). PX4's build system cannot handle the space in this
# project's path, which is why it lives outside the repo.
PX4-Autopilot

# Python
__pycache__/
*.pyc
.venv/
venv/

# Sim runtime artifacts
logs/

# Recorded clips: regenerate with scripts/run_test_matrix.sh
data/clips/
# Recorded clips are ignored, but the built fine-tune dataset IS committed
# (60 MB) so the PC can train immediately after cloning, before the simulator
# is even set up there. Training runs stay local.
data/finetune/runs/
# Trained weights (binary artifacts; rebuild with camera/finetune.py)
camera/weights/
*.ulg
.sim_pids
build/

# macOS
.DS_Store

# terrain retrain tiles (null-result experiment; rebuild via camera/build_finetune_dataset.py from terrain training clips)
data/finetune_terrain/
data/finetune_zoom/
data/finetune_real/
data/finetune_hardneg/
data/finetune_birdfix/
data/finetune_sahi2x/
data/finetune_realblur/
data/finetune_colour/
data/external/
weights/
data/finetune/dataset_mixed*.yaml
data/finetune/train_mixed*.txt
runs/experiments/
runs/m3_*.log
runs/*_kwargs.json
data/finetune/labels/*.cache
data/finetune/images/*.cache
runs/m4_*.log
runs/m5_*.log
data/clips/eval_birds_broken_cloud/
data/clips/terrain_ir_canopy_cloud/
data/clips/range_1km/
