<?xml version="1.0"?>
<model>
  <name>target_drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>FPV drone system project</name></author>
  <description>
    Visual-only stand-in for a 5-inch FPV quad (~0.25 m motor-to-motor).
    Used in SIH fallback mode, where PX4 simulates the flight dynamics
    internally and pose_mirror.py drives this model's pose in Gazebo so the
    detection-station sensors can see it. Non-static (so it shows up in
    dynamic_pose ground truth) but gravity-free and collision-free, so
    physics never applies forces to it.
  </description>
</model>
