<?xml version="1.0" encoding="UTF-8"?>
<!--
  detection_world: open environment with a fixed ground-based detection station.

  Station is at the origin. The camera looks EAST (+X). The target drone
  operates in a block roughly 30-80 m east of the station at 5-30 m altitude,
  so it subtends a small pixel footprint (the regime Phase 2 cares about).

  All required gz-sim systems are declared explicitly: when a world declares
  any plugin, gz-sim does NOT load its default server config, so everything
  the PX4 x500 model needs (imu/mag/air-pressure/navsat) is listed here too.
-->
<sdf version="1.9">
  <world name="detection_world">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.55 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>800 800</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.6 0.45 1</ambient>
            <diffuse>0.55 0.6 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Fixed ground detection station ============ -->
    <model name="detection_station">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- equipment cabin -->
      <link name="base">
        <pose>0 0 0.5 0 0 0</pose>
        <visual name="cabin">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.32 1</ambient>
            <diffuse>0.3 0.3 0.32 1</diffuse>
          </material>
        </visual>
        <collision name="cabin_col">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
        </collision>
      </link>

      <!-- sensor mast -->
      <link name="mast">
        <pose>0 0 1.75 0 0 0</pose>
        <visual name="pole">
          <geometry><cylinder><radius>0.04</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- CAMERA: 2.5 m up, looking EAST (+X), pitched 8.6 deg up.
           720p @ 15 Hz keeps CPU/RAM sane on this machine; raise later if needed. -->
      <link name="camera_link">
        <pose>0.1 0 2.5 0 -0.15 0</pose>
        <visual name="camera_body">
          <geometry><box><size>0.12 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="station_camera" type="camera">
          <topic>/detection_station/camera/image</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>1000</far>
            </clip>
            <camera_info_topic>/detection_station/camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </link>

      <!-- MICROPHONE ARRAY mount (pose marker only — Gazebo has no acoustics;
           Phase 3 synthesizes audio from sim state relative to this pose). -->
      <link name="mic_array_link">
        <pose>0 0.35 1.1 0 0 0</pose>
        <visual name="mic_array">
          <geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.15 0.4 1</ambient>
            <diffuse>0.15 0.15 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- CUED TELEPHOTO on a pan-tilt head. The 6 deg lens sees 1% of the
           wide field and only works because it is pointed, so the head is
           part of the design rather than decoration. -->
      <link name="gimbal_link">
        <pose>0 0 2.72 0 0 0</pose>
        <visual name="yoke">
          <geometry><cylinder><radius>0.07</radius><length>0.10</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.22 0.22 0.24 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="tele_barrel">
        <pose>0.13 0 2.78 0 -0.15 0</pose>
        <visual name="barrel">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.34</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.12 0.14 1</ambient>
            <diffuse>0.12 0.12 0.14 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- PASSIVE radar (PCL), distinct from radar_link below which is the
           ACTIVE emitter. These two only RECEIVE. Drawn at the size the
           physics implies: 8 elements at LTE1800 (lambda 0.167 m) is ~0.67 m
           across, and the small Yagi points at the illuminator to capture a
           reference copy of its signal. -->
      <link name="pcl_panel">
        <pose>-0.35 0 1.90 0 0 3.1416</pose>
        <visual name="panel">
          <geometry><box><size>0.05 0.67 0.42</size></box></geometry>
          <material>
            <ambient>0.18 0.20 0.22 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="pcl_reference">
        <pose>-0.35 0 2.45 0 0 2.44</pose>
        <visual name="boom">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.55</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- RADAR panel mount (pose marker only — Phase 4 computes returns from
           ground-truth kinematics relative to this pose, plus a noise model). -->
      <link name="radar_link">
        <pose>0.15 -0.35 1.3 0 -0.1 0</pose>
        <visual name="radar_panel">
          <geometry><box><size>0.04 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.62 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- PX4 default reference location (Zurich Irchel) — keep identical to
         PX4's own worlds so GPS init behaves exactly like stock setups. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <model name="car_rig"><static>true</static>
    <link name="bar_front"><pose>0.45 0 1.55 0 0 1.5708</pose>
      <visual name="v"><geometry><cylinder><radius>0.022</radius><length>1.3</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual></link>
    <link name="bar_rear"><pose>-0.45 0 1.55 0 0 1.5708</pose>
      <visual name="v"><geometry><cylinder><radius>0.022</radius><length>1.3</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual></link>
    <link name="plate"><pose>0 0 1.60 0 0 0</pose>
      <visual name="v"><geometry><box><size>1.05 0.62 0.03</size></box></geometry>
        <material><ambient>0.25 0.26 0.28 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material></visual></link>
    <link name="ebox"><pose>-0.30 0 1.72 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.36 0.3 0.2</size></box></geometry>
        <material><ambient>0.2 0.21 0.23 1</ambient><diffuse>0.2 0.21 0.23 1</diffuse></material></visual></link>
    <link name="mast"><pose>0.10 0 1.95 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.028</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.45 0.45 0.47 1</diffuse></material></visual></link>
    <link name="head_yoke"><pose>0.10 0 2.20 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.09</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual></link>
    <link name="tele"><pose>0.24 0 2.26 0 -0.15 0</pose>
      <visual name="v"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.052</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual></link>
    <link name="wide"><pose>0.20 0.10 2.26 0 -0.15 0</pose>
      <visual name="v"><geometry><box><size>0.09 0.06 0.06</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
    <link name="thermal"><pose>0.20 -0.10 2.26 0 -0.15 0</pose>
      <visual name="v"><geometry><box><size>0.07 0.05 0.05</size></box></geometry>
        <material><ambient>0.45 0.15 0.12 1</ambient><diffuse>0.45 0.15 0.12 1</diffuse></material></visual></link>
    <link name="pcl_rail"><pose>-0.10 0 1.68 0 0 1.5708</pose>
      <visual name="v"><geometry><box><size>0.04 1.02 0.03</size></box></geometry>
        <material><ambient>0.22 0.24 0.26 1</ambient><diffuse>0.22 0.24 0.26 1</diffuse></material></visual></link>
    <link name="pcl_el0"><pose>-0.10 -0.5 1.83 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.006</radius><length>0.27</length></cylinder></geometry>
        <material><ambient>0.78 0.78 0.8 1</ambient><diffuse>0.78 0.78 0.8 1</diffuse></material></visual></link>
    <link name="pcl_el1"><pose>-0.10 -0.25 1.83 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.006</radius><length>0.27</length></cylinder></geometry>
        <material><ambient>0.78 0.78 0.8 1</ambient><diffuse>0.78 0.78 0.8 1</diffuse></material></visual></link>
    <link name="pcl_el2"><pose>-0.10 0.0 1.83 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.006</radius><length>0.27</length></cylinder></geometry>
        <material><ambient>0.78 0.78 0.8 1</ambient><diffuse>0.78 0.78 0.8 1</diffuse></material></visual></link>
    <link name="pcl_el3"><pose>-0.10 0.25 1.83 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.006</radius><length>0.27</length></cylinder></geometry>
        <material><ambient>0.78 0.78 0.8 1</ambient><diffuse>0.78 0.78 0.8 1</diffuse></material></visual></link>
    <link name="pcl_el4"><pose>-0.10 0.5 1.83 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.006</radius><length>0.27</length></cylinder></geometry>
        <material><ambient>0.78 0.78 0.8 1</ambient><diffuse>0.78 0.78 0.8 1</diffuse></material></visual></link>
    <link name="ref_boom"><pose>-0.40 0.34 1.95 0 0 2.44</pose>
      <visual name="v"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.01</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.58 0.58 0.6 1</ambient><diffuse>0.58 0.58 0.6 1</diffuse></material></visual></link>
    <link name="ref_el0"><pose>-0.5800000000000001 0.44000000000000006 1.95 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.58 0.58 0.6 1</ambient><diffuse>0.58 0.58 0.6 1</diffuse></material></visual></link>
    <link name="ref_el1"><pose>-0.46 0.44000000000000006 1.95 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.58 0.58 0.6 1</ambient><diffuse>0.58 0.58 0.6 1</diffuse></material></visual></link>
    <link name="ref_el2"><pose>-0.34 0.44000000000000006 1.95 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.58 0.58 0.6 1</ambient><diffuse>0.58 0.58 0.6 1</diffuse></material></visual></link>
    <link name="ref_el3"><pose>-0.22000000000000003 0.44000000000000006 1.95 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.58 0.58 0.6 1</ambient><diffuse>0.58 0.58 0.6 1</diffuse></material></visual></link>
    <link name="mic_x"><pose>0.10 0 1.66 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.3 0.014 0.014</size></box></geometry>
        <material><ambient>0.3 0.3 0.33 1</ambient><diffuse>0.3 0.3 0.33 1</diffuse></material></visual></link>
    <link name="mic_y"><pose>0.10 0 1.66 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.014 0.3 0.014</size></box></geometry>
        <material><ambient>0.3 0.3 0.33 1</ambient><diffuse>0.3 0.3 0.33 1</diffuse></material></visual></link>
    <link name="mic0"><pose>0.25 0.15 1.67 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.011</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.45 1</ambient><diffuse>0.12 0.12 0.45 1</diffuse></material></visual></link>
    <link name="mic1"><pose>0.25 -0.15 1.67 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.011</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.45 1</ambient><diffuse>0.12 0.12 0.45 1</diffuse></material></visual></link>
    <link name="mic2"><pose>-0.05 0.15 1.67 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.011</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.45 1</ambient><diffuse>0.12 0.12 0.45 1</diffuse></material></visual></link>
    <link name="mic3"><pose>-0.05 -0.15 1.67 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.011</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.45 1</ambient><diffuse>0.12 0.12 0.45 1</diffuse></material></visual></link>
  </model>
  <model name="car"><static>true</static>
    <link name="body"><pose>0 0 0.75 0 0 0</pose>
      <visual name="v"><geometry><box><size>4.3 1.8 0.8</size></box></geometry>
        <material><ambient>0.33 0.37 0.46 1</ambient><diffuse>0.33 0.37 0.46 1</diffuse></material></visual></link>
    <link name="cabin"><pose>-0.15 0 1.28 0 0 0</pose>
      <visual name="v"><geometry><box><size>2.1 1.62 0.62</size></box></geometry>
        <material><ambient>0.22 0.25 0.33 1</ambient><diffuse>0.22 0.25 0.33 1</diffuse></material></visual></link>
    <link name="wheel0"><pose>1.35 0.92 0.34 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual></link>
    <link name="wheel1"><pose>1.35 -0.92 0.34 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual></link>
    <link name="wheel2"><pose>-1.35 0.92 0.34 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual></link>
    <link name="wheel3"><pose>-1.35 -0.92 0.34 1.5708 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual></link>
  </model>
  <model name="view0"><static>true</static>
    <link name="l"><pose>2.9 -2.4 2.55 0 0.1 2.47</pose>
      <sensor name="c0" type="camera"><topic>/rig/view0</topic>
        <update_rate>4</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>0.75</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>200</far></clip></camera>
      </sensor></link></model>
  <model name="view1"><static>true</static>
    <link name="l"><pose>0.1 -3.1 2.05 0 -0.02 1.5708</pose>
      <sensor name="c1" type="camera"><topic>/rig/view1</topic>
        <update_rate>4</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>0.75</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>200</far></clip></camera>
      </sensor></link></model>
  <model name="view2"><static>true</static>
    <link name="l"><pose>3.1 0.05 2.75 0 0.16 3.1416</pose>
      <sensor name="c2" type="camera"><topic>/rig/view2</topic>
        <update_rate>4</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>0.75</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>200</far></clip></camera>
      </sensor></link></model>

  </world>
</sdf>
