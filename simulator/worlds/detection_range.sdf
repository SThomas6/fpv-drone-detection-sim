<?xml version="1.0" ?>
<!--
  detection_range.sdf - Phase 1 world for the anti-drone detection simulator.

  Contents:
    - Open flat environment (ground plane, sun, a few visual reference objects)
    - Fixed ground detection station at the origin area:
        * camera on a 3 m mast (real simulated sensor -> publishes images)
        * microphone representation (visual only; audio is synthesized in
          Phase 3 from sim state - Gazebo has no acoustic simulation)
        * radar representation (visual only; radar measurements are computed
          in Phase 4 from ground-truth pose + noise model)
    - The target drone is NOT in this file; PX4 SITL spawns its own vehicle
      model into this world at launch.
-->
<sdf version="1.9">
  <world name="detection_range">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.65 0.78 0.9</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.35 0.5 0.3 1</ambient>
            <diffuse>0.35 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual reference objects so camera frames have background structure -->
    <model name="marker_50m">
      <static>true</static>
      <pose>50 0 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 2</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_100m">
      <static>true</static>
      <pose>100 20 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 3</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ Ground detection station ============ -->
    <!-- Placed 15 m behind the origin (where the drone spawns), looking at
         the patrol volume. Static: it never moves. -->
    <model name="detection_station">
      <static>true</static>
      <pose>-15 0 0 0 0 0</pose>

      <!-- Camera mast -->
      <link name="mast">
        <pose>0 0 1.5 0 0 0</pose>
        <visual name="mast_visual">
          <geometry><cylinder><radius>0.06</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>

      <!-- Camera head: 3 m up, pitched up ~10 deg toward the patrol volume -->
      <link name="camera_link">
        <pose>0.1 0 3.05 0 -0.17 0</pose>
        <visual name="camera_visual">
          <geometry><box><size>0.15 0.1 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="station_camera" type="camera">
          <topic>detection_station/camera</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>1000</far></clip>
          </camera>
        </sensor>
      </link>

      <!-- Microphone representation (no simulated audio in Gazebo).
           Phase 3 will synthesize audio as a function of drone range/velocity
           relative to this pose. -->
      <link name="microphone_link">
        <pose>0.5 0.6 1.0 0 0 0</pose>
        <visual name="mic_visual">
          <geometry><cylinder><radius>0.08</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.6 0.6 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Radar representation. Phase 4 computes range/bearing/elevation/
           radial velocity from ground truth relative to this pose + noise. -->
      <link name="radar_link">
        <pose>-0.5 -0.6 1.6 0 -0.35 0</pose>
        <visual name="radar_visual">
          <geometry><box><size>0.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
